    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
